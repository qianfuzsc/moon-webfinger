name = "localdev/moon-webfinger"

version = "0.1.0-dev"

readme = "README.md"

license = "Apache-2.0"

description = "RFC 7033 WebFinger and JRD parser, serializer, request builder, query and audit toolkit for MoonBit."

keywords = [
  "webfinger",
  "rfc7033",
  "jrd",
  "identity",
  "discovery",
  "json",
  "http",
  "moonbit",
]

warnings = "-reserved_keyword"

options(
  exclude: [ "_build/**" ],
)
